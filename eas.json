{
  "cli": {
    "version": ">= 24.7.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PERF_OVERLAY": "1"
      }
    },
    "profiling": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PERF_OVERLAY": "1"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
