{
  "cli": {
    "version": ">= 24.7.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PERF_OVERLAY": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "profiling": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PERF_OVERLAY": "1",
        "EXPO_PUBLIC_CERT": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_NO_DEV_CLIENT": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  }
}
